+#ifdef MOCK_BPF
+std::cout << "Hello Pavel! MOCK_BPF is defined" << std::endl;
+#else
+std::cout << "Hello Pavel! MOCK_BPF is not defined" << std::endl;
+#endif
+std::string output_counter_path = std::string("/sys/fs/bpf/map_timeInState_output_counter");
+std::string output_val_path = std::string("/sys/fs/bpf/map_timeInState_output_val");
+std::cout << "a" << std::endl;
+//int mMapFd = bpf_obj_get(time_in_state_map.c_str());
+android::bpf::BpfMap<int, unsigned long> valMap(output_val_path.c_str());
+android::bpf::BpfMap< int, unsigned long> countMap(output_counter_path.c_str());
+block_trace_output_t def_output = {
+        .ts = 0,
+        .name = "",
+        .pid = 0,
+        .dev = 0,
+        .rwflag = 0,
+        .sector = 0,
+        .len = 0,
+        .delta = 0,
+    };
+std::cout << "a" << std::endl;
+//android::base::Result<unsigned long> result0 = myMap.readValue(0), result1 = myMap.readValue(1);
+std::cout << "a" << std::endl;
+std::cout <<  "Count: " << countMap.readValue(0).value_or(42) << " last used sector: " << valMap.readValue(0).value_or(42UL) << std::endl;
+
+
+}
diff --git a/compile_print_test.rc b/compile_print_test.rc
