+// time block I/O
+DEFINE_BPF_PROG("tracepoint/block/block_bio_queue", AID_ROOT, AID_SYSTEM, trace_bio_start)
+(tp_args *args)
+{
+    char str2[] = "block_bio_queue: dev:%u rwflag:%c sector: %ld, size: %u";
+    hash_key key = {
+        .dev = args->dev,
+        .rwflag = get_rwflag_tp(args->rwbs),
+        .sector = args->sector
+    };
+    char rwflag = key.rwflag == 1 ? 'W' : 'R';
+
+    
+
+    start_req_t start_req = {
+        .ts = bpf_ktime_get_ns(),
+        .data_len = 0
+    };
+    str2[30] = rwflag;
+    bpf_trace_printk(str2, sizeof(str2), key.dev, key.sector, args->nr_sector);
+
+    // start.update(&key, &start_req);
+    bpf_start_update_elem(&key, &start_req, BPF_ANY);
+    return 0;
+}
+
+
+DEFINE_BPF_PROG("tracepoint/block/block_rq_issue", AID_ROOT, AID_SYSTEM, trace_req_start)
+(tp_args *args)
+{
+    char str2[] = "block_rq_issue: dev:%u rwflag:W sector: %ld, size: %u";
+    hash_key key = {
+        .dev = args->dev,
+        .rwflag = get_rwflag_tp(args->rwbs),
+        .sector = args->sector
+    };
+    char rwflag = key.rwflag == 1 ? 'W' : 'R';
+
+    
+
+    start_req_t start_req = {
+        .ts = bpf_ktime_get_ns(),
+        .data_len = 0
+    };
+    str2[30] = rwflag;
+    bpf_trace_printk(str2, sizeof(str2), key.dev, key.sector, args->nr_sector);
+
+    // start.update(&key, &start_req);
+    bpf_start_update_elem(&key, &start_req, BPF_ANY);
+    return 0;
+}
+
+
+// output
+static int __trace_req_completion(tp_args *ctx, hash_key key)
+{
+    start_req_t *startp;
+    val_t *valp;
+    data_t data = {};
+    //gendisk *rq_disk;
+    __u64 ts;
+
+    // fetch timestamp and calculate delta
+    startp = bpf_start_lookup_elem(&key);
+    // startp = start.lookup(&key);
+    if (startp == 0) {
+        // missed tracing issue
+        return 0;
+    }
+    ts = bpf_ktime_get_ns();
+    //rq_disk = req->rq_disk;
+    data.delta = ts - startp->ts;
+    data.ts = ts / 1000;
+    data.qdelta = 0;
+    data.len = startp->data_len;
+
+    valp = bpf_infobyreq_lookup_elem(&key);
+    // valp = infobyreq.lookup(&key);
+    if (valp == 0) {
+        data.name[0] = '?';
+        data.name[1] = 0;
+    } else {
+        if (0) {
+            data.qdelta = startp->ts - valp->ts;
+        }
+        data.pid = valp->pid;
+        data.sector = key.sector;
+        data.dev = key.dev;
+        bpf_probe_read(&data.name, sizeof(data.name), valp->name);
+    }
+
+    data.sector = key.sector;
+    data.rwflag = key.rwflag;
+
+    perf_submit(data);
+    bpf_start_delete_elem(&key);
+    // start.delete(&key);
+    bpf_infobyreq_delete_elem(&key);
+    // infobyreq.delete(&key);
+
+    return 0;
+}
+
+
+DEFINE_BPF_PROG("tracepoint/block/block_rq_complete", AID_ROOT, AID_SYSTEM, trace_req_completion_tp)
+(tp_args *args)
+{
+    hash_key key = {
+        .dev = args->dev,
+        .rwflag = get_rwflag_tp(args->rwbs),
+        .sector = args->sector
+    };
+
+    char str2[] = "block_rq_complete: dev: %d, rwflag: %d, sector: %d";
+    bpf_trace_printk(str2, sizeof(str2), key.dev, key.rwflag, key.sector);
+
+    return __trace_req_completion(args, key);
+}
