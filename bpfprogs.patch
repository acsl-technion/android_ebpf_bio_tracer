+static inline void perf_submit(data_t data) {
+    int key = 0;
+    unsigned long reset_counter = 0;
+    // char rwflag = data.rwflag == 1 ? 'W' : 'R';
+    // block_trace_output_t trace_output = {
+    //     .ts = data.ts ,
