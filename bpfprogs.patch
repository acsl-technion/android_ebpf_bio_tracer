+    //     .delta = data.delta
+    // };
+    // char msg1[] = "%llu %s %d";// %d";
+    // bpf_trace_printk(msg1, sizeof(msg1),
+    //     data.ts,
+    //     data.name,
+    //     data.pid
+    //     );
+        // data.dev
+    // bpf_trace_printk("%c %llu %llu %llu\n",
+    //     rwflag,
+    //     data.sector,
+    //     data.len,
+    //     data.delta
+    //     );
+    unsigned long *counter = bpf_output_counter_lookup_elem(&key);
+    if (counter == NULL) bpf_output_counter_update_elem(&key, &reset_counter, BPF_ANY);
+    else {
+        *counter = *counter + 1;
+        bpf_output_counter_update_elem(&key, counter, BPF_ANY);
+    }
+    bpf_output_val_update_elem(&key, &data.sector, BPF_ANY);
+    
+}
